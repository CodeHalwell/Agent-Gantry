---
import DocsLayout from '../layouts/DocsLayout.astro';
import ToolJourney from '../components/ToolJourney';
import ProviderMatrix from '../components/ProviderMatrix';
import { buildHighlightedJourneyStages } from '../lib/journey';

const stages = await buildHighlightedJourneyStages();
---
<DocsLayout title="Agent-Gantry Documentation">
  <section class="hero">
    <p class="eyebrow">Universal Tool Orchestration Platform</p>
    <h1>Give every agent the right tools at the right moment.</h1>
    <p class="lead">Agent-Gantry is a Python 0.8.0 library for semantic tool routing, secure execution, provider schema conversion, MCP/A2A interoperability, and framework adapters. It replaces prompt-stuffing hundreds of tools with a governed retrieval-and-execution layer.</p>
    <ul role="list" style="display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 0; list-style: none;">
      <li><a class="pill" href="/Agent-Gantry/docs/getting-started/">Start the journey →</a></li>
      <li><a class="pill" href="/Agent-Gantry/docs/api/">API reference</a></li>
      <li><a class="pill" href="/Agent-Gantry/docs/frameworks/agent-framework/">Microsoft Agent Framework →</a></li>
    </ul>
  </section>
  <section class="grid">
    <div class="card"><div class="kpi">~79–90%</div><h3>Less tool context</h3><p>Retrieve top-k tools instead of injecting the entire registry into every model call.</p></div>
    <div class="card"><div class="kpi">1×</div><h3>Register once</h3><p>Transcode to OpenAI, Anthropic, Gemini, framework-native adapters, MCP, and A2A paths.</p></div>
    <div class="card"><div class="kpi">0-trust</div><h3>Execution guardrails</h3><p>Policies, capabilities, timeouts, retries, rate limits, circuit breakers, and telemetry.</p></div>
  </section>
  <h2>Interactive implementation map</h2>
  <ToolJourney client:load stages={stages} />
  <h2>Current integration surface</h2>
  <ProviderMatrix />
</DocsLayout>
