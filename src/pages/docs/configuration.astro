---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
---
<DocsLayout title="Configuration | dotfetch">
  <h1>Configuration</h1>
  <p class="lead">dotfetch works with zero configuration, but production systems usually configure routing, persistence, execution, telemetry, and provider extras.</p>

  <CodeBlock lang="python" title="DotFetchConfig" code={`from dotfetch import DotFetch
from dotfetch.schema.config import DotFetchConfig

config = DotFetchConfig(
    vector_store={"provider": "lancedb", "path": ".dotfetch/tools.lance"},
    embedder={"provider": "nomic"},
    routing={"score_threshold": 0.5, "use_llm_for_intent": False},
    execution={"default_timeout_ms": 30000, "max_retries": 2},
    telemetry={"provider": "console"},
)
fetcher = DotFetch(config=config)`} />

  <h2>Common extras</h2>
  <CodeBlock lang="bash" code={`uv add "dotfetch[openai]"          # OpenAI, Azure OpenAI, OpenRouter
uv add "dotfetch[anthropic]"       # Claude tools
uv add "dotfetch[google-genai]"    # Gemini function calling
uv add "dotfetch[lancedb,nomic]"   # local durable semantic search
uv add "dotfetch[mcp,a2a]"         # protocol bridges
uv add "dotfetch[agent-frameworks]"
uv add "dotfetch[pydantic-ai]"     # Pydantic AI 2.x
uv add "dotfetch[openai-agents]"   # OpenAI Agents SDK (own environment)
uv add "dotfetch[langgraph]"       # LangGraph + LangChain 1.x ([langchain] for LangChain alone)
uv add "dotfetch[google-adk]"      # Google ADK 2.x
uv add "dotfetch[crewai]"          # CrewAI (Python 3.10-3.13)
uv add "dotfetch[llamaindex]"      # LlamaIndex (llama-index-core 0.13+)
uv add "dotfetch[strands]"         # Strands Agents 1.38+
uv add "dotfetch[agno]"            # Agno 2.6.10+
uv add "dotfetch[haystack]"        # Haystack 3.x
uv add "dotfetch[dspy]"            # DSPy 3.5+`} />
</DocsLayout>
