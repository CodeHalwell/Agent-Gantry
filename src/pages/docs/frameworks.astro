import ProviderMatrix from '../../components/ProviderMatrix';
import CodeBlock from '../../components/CodeBlock.astro';
const guides = [
  ['Microsoft Agent Framework', '/dotfetch/docs/frameworks/agent-framework/'],
  ['LangChain', '/dotfetch/docs/frameworks/langchain/'],
  ['LangGraph', '/dotfetch/docs/frameworks/langgraph/'],
  ['LlamaIndex', '/dotfetch/docs/frameworks/llamaindex/'],
