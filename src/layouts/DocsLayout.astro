---
import '../styles/global.css';
interface Link { label: string; href: string }
interface Section { section: string; links: Link[] }
const { title = 'Agent-Gantry Docs', description = 'Universal tool orchestration for LLM agents.' } = Astro.props;
const nav: Section[] = [
  { section: 'Start', links: [{label:'Home',href:'/Agent-Gantry/'},{label:'Quickstart',href:'/Agent-Gantry/docs/getting-started/'},{label:'Implementation Journey',href:'/Agent-Gantry/docs/journey/'}]},
  { section: 'Core', links: [{label:'Architecture',href:'/Agent-Gantry/docs/architecture/'},{label:'Configuration',href:'/Agent-Gantry/docs/configuration/'},{label:'API Reference',href:'/Agent-Gantry/docs/api/'}]},
  { section: 'Integrations', links: [{label:'Frameworks overview',href:'/Agent-Gantry/docs/frameworks/'},{label:'Providers',href:'/Agent-Gantry/docs/providers/'},{label:'Operations',href:'/Agent-Gantry/docs/operations/'}]},
  { section: 'Framework guides', links: [
    {label:'Microsoft Agent Framework',href:'/Agent-Gantry/docs/frameworks/agent-framework/'},
    {label:'LangChain',href:'/Agent-Gantry/docs/frameworks/langchain/'},
    {label:'LangGraph',href:'/Agent-Gantry/docs/frameworks/langgraph/'},
    {label:'LlamaIndex',href:'/Agent-Gantry/docs/frameworks/llamaindex/'},
    {label:'CrewAI',href:'/Agent-Gantry/docs/frameworks/crewai/'},
    {label:'AutoGen',href:'/Agent-Gantry/docs/frameworks/autogen/'},
    {label:'Semantic Kernel',href:'/Agent-Gantry/docs/frameworks/semantic-kernel/'},
    {label:'Google ADK',href:'/Agent-Gantry/docs/frameworks/google-adk/'},
    {label:'Pydantic AI',href:'/Agent-Gantry/docs/frameworks/pydantic-ai/'},
    {label:'OpenAI Agents SDK',href:'/Agent-Gantry/docs/frameworks/openai-agents/'},
    {label:'Smolagents',href:'/Agent-Gantry/docs/frameworks/smolagents/'},
    {label:'Haystack',href:'/Agent-Gantry/docs/frameworks/haystack/'},
    {label:'Agno',href:'/Agent-Gantry/docs/frameworks/agno/'},
  ]},
  { section: 'Advanced guides', links: [
    {label:'Advanced Agent Framework',href:'/Agent-Gantry/docs/frameworks/agent-framework/advanced/'},
    {label:'Advanced LangChain',href:'/Agent-Gantry/docs/frameworks/langchain/advanced/'},
    {label:'Advanced LangGraph',href:'/Agent-Gantry/docs/frameworks/langgraph/advanced/'},
    {label:'Advanced LlamaIndex',href:'/Agent-Gantry/docs/frameworks/llamaindex/advanced/'},
    {label:'Advanced CrewAI',href:'/Agent-Gantry/docs/frameworks/crewai/advanced/'},
    {label:'Advanced AutoGen',href:'/Agent-Gantry/docs/frameworks/autogen/advanced/'},
    {label:'Advanced Semantic Kernel',href:'/Agent-Gantry/docs/frameworks/semantic-kernel/advanced/'},
    {label:'Advanced Google ADK',href:'/Agent-Gantry/docs/frameworks/google-adk/advanced/'},
    {label:'Advanced Pydantic AI',href:'/Agent-Gantry/docs/frameworks/pydantic-ai/advanced/'},
    {label:'Advanced OpenAI Agents',href:'/Agent-Gantry/docs/frameworks/openai-agents/advanced/'},
    {label:'Advanced Smolagents',href:'/Agent-Gantry/docs/frameworks/smolagents/advanced/'},
    {label:'Advanced Haystack',href:'/Agent-Gantry/docs/frameworks/haystack/advanced/'},
    {label:'Advanced Agno',href:'/Agent-Gantry/docs/frameworks/agno/advanced/'},
  ]},
];
---
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><title>{title}</title></head>
<body><div class="shell"><aside class="sidebar"><a class="brand" href="/Agent-Gantry/"><span class="logo"></span><span><h1>Agent-Gantry</h1><p>v0.8.0 docs</p></span></a>{nav.map(({section,links})=>{
  const sectionId = section.toLowerCase().replace(/\s+/g, '-');
  return <div class="nav-section"><h2 id={sectionId}>{section}</h2><ul aria-labelledby={sectionId} style="list-style:none;padding:0;margin:0;">{links.map(({label,href})=><li><a href={href}>{label}</a></li>)}</ul></div>
})}<div class="nav-section"><h2 id="project">Project</h2><ul aria-labelledby="project" style="list-style:none;padding:0;margin:0;"><li><a href="https://github.com/CodeHalwell/Agent-Gantry">GitHub</a></li><li><a href="/Agent-Gantry/docs/quick-reference/">Quick reference</a></li></ul></div></aside><main class="main"><div class="topbar"><span>Context is precious. Execution is sacred. Trust is earned.</span><span class="pill">Python 3.10–3.13</span></div><div class="content"><slot /></div><footer class="footer">Built with Astro, React, and TypeScript. Documentation reflects Agent-Gantry 0.8.0.</footer></main></div></body></html>
