---
import { highlightCode } from '../lib/highlight';

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'python', title } = Astro.props;
// A titled block names its region after the title, so a page with several
// code blocks does not offer a list of identical "Code snippet" landmarks.
const html = await highlightCode(code, lang, title ? `Code snippet: ${title}` : undefined);
---

<figure class="code-block">
  {title && <figcaption class="code-title">{title}</figcaption>}
  <Fragment set:html={html} />
</figure>
